generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  role      String
  whatsapp  String   @default("")
  imageUrl  String   @default("")
  upiId     String   @default("")
  roleId    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  roleRef Role? @relation(fields: [roleId], references: [id], onDelete: Restrict)

  cashTransactions         CashTx[]          @relation("CashTxStaff")
  requestedAdvances        AdvanceRequest[]  @relation("AdvanceRequester")
  fundedAdvances           AdvanceRequest[]  @relation("AdvanceFundingStaff")
  approvedAdvances         AdvanceRequest[]  @relation("AdvanceApprover")
  createdReminders         Reminder[]        @relation("ReminderCreator")
  targetedReminders        Reminder[]        @relation("ReminderTarget")
  acknowledgedReminders    Reminder[]        @relation("ReminderAcknowledger")
  assignedTasks            Task[]            @relation("TaskAssignee")
  completedTasks           Task[]            @relation("TaskCompleter")
  requestedTaskCompletions Task[]            @relation("TaskCompletionRequester")
  sentMessages             Message[]         @relation("MessageSender")
  receivedMessages         Message[]         @relation("MessageReceiver")
  createdChatGroups        ChatGroup[]       @relation("ChatGroupCreator")
  chatGroupMemberships     ChatGroupMember[]
  sentGroupMessages        GroupMessage[]    @relation("GroupMessageSender")
  deletedLogs              DeletedLog[]      @relation("DeletedLogUser")

  @@index([roleId])
  @@index([isActive])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String   @default("")
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Labour {
  id            String   @id @default(uuid())
  name          String
  whatsapp      String
  monthlySalary Float
  imageUrl      String   @default("")
  status        String   @default("active")
  employeeType  String   @default("labourer")
  department    String   @default("")
  phonePeNumber String   @default("")
  upiId         String   @default("")
  phonePeQrUrl  String   @default("")
  faceEmbedding Float[]  @default([])
  workingHours  Float    @default(8)
  shiftStart    String   @default("08:30")
  shiftEnd      String   @default("20:30")
  gender        String   @default("Male")
  empCode       String   @default("")
  createdAt     DateTime @default(now())

  attendance       Attendance[]
  cashTransactions CashTx[]
  advanceRequests  AdvanceRequest[]

  @@index([name])
  @@index([status])
  @@index([empCode])
}

model Attendance {
  id                   String     @id @default(uuid())
  labourId             String
  date                 DateTime
  status               String
  checkIn              DateTime?
  checkOut             DateTime?
  punches              DateTime[] @default([])
  activeHours          Float      @default(0)
  awayHours            Float      @default(0)
  permissionHours      Float      @default(0)
  isPermissionApproved Boolean    @default(false)
  overtimeHours        Float      @default(0)
  remarks              String     @default("")

  labour Labour @relation(fields: [labourId], references: [id], onDelete: Restrict)

  @@unique([labourId, date])
  @@index([date])
}

model CashTx {
  id          String   @id @default(uuid())
  txType      String
  category    String
  amount      Float
  date        DateTime
  description String   @default("")
  paymentMode String   @default("handcash")
  staffId     String
  labourId    String?

  staff    User             @relation("CashTxStaff", fields: [staffId], references: [id], onDelete: Restrict)
  labour   Labour?          @relation(fields: [labourId], references: [id], onDelete: Restrict)
  advances AdvanceRequest[]

  @@index([date])
  @@index([category])
  @@index([staffId])
}

model AdvanceRequest {
  id               String   @id @default(uuid())
  labourId         String
  amount           Float
  date             DateTime
  reason           String   @default("")
  status           String   @default("pending")
  deductedAmount   Float    @default(0)
  requestedBy      String
  fundingStaffId   String?
  fundingStaffRef  String   @default("")
  fundingStaffName String   @default("")
  approvedBy       String?
  expenseTxId      String?

  labour       Labour  @relation(fields: [labourId], references: [id], onDelete: Restrict)
  requester    User    @relation("AdvanceRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  fundingStaff User?   @relation("AdvanceFundingStaff", fields: [fundingStaffId], references: [id], onDelete: Restrict)
  approver     User?   @relation("AdvanceApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  expenseTx    CashTx? @relation(fields: [expenseTxId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([status])
  @@index([fundingStaffId])
}

model Reminder {
  id             String    @id @default(uuid())
  message        String
  targetDate     DateTime
  status         String    @default("pending")
  type           String    @default("general")
  targetStaffId  String?
  createdBy      String
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  targetStaff  User? @relation("ReminderTarget", fields: [targetStaffId], references: [id], onDelete: Restrict)
  creator      User  @relation("ReminderCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  acknowledger User? @relation("ReminderAcknowledger", fields: [acknowledgedBy], references: [id], onDelete: Restrict)

  @@index([targetDate])
  @@index([status])
}

model Task {
  id                    String    @id @default(uuid())
  title                 String
  taskType              String    @default("custom")
  frequency             String    @default("one-time")
  status                String    @default("pending")
  assignedTo            String?
  completedBy           String?
  completedAt           DateTime?
  completionRequestedBy String?
  completionRequestedAt DateTime?
  description           String    @default("")
  language              String    @default("en")
  remarks               String    @default("")
  nextFollowup          String    @default("")
  comments              Json      @default("[]")
  seenByOwner           Boolean   @default(false)
  seenAt                DateTime?
  reminderDateTime      DateTime?
  reminderAlarmArmed    Boolean   @default(false)
  reminderNote          String    @default("")
  createdAt             DateTime  @default(now())

  assignee            User? @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: Restrict)
  completer           User? @relation("TaskCompleter", fields: [completedBy], references: [id], onDelete: Restrict)
  completionRequester User? @relation("TaskCompletionRequester", fields: [completionRequestedBy], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([taskType])
  @@index([reminderDateTime])
  @@index([completionRequestedAt])
}

model Message {
  id        String   @id @default(uuid())
  sender    String
  receiver  String
  text      String   @default("")
  mediaUrl  String   @default("")
  mediaType String   @default("none")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  senderUser   User @relation("MessageSender", fields: [sender], references: [id], onDelete: Restrict)
  receiverUser User @relation("MessageReceiver", fields: [receiver], references: [id], onDelete: Restrict)

  @@index([sender, receiver, createdAt])
  @@index([receiver, isRead])
}

model ChatGroup {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  avatarUrl   String   @default("")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  creator  User              @relation("ChatGroupCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  members  ChatGroupMember[]
  messages GroupMessage[]

  @@index([updatedAt])
}

model ChatGroupMember {
  id         String    @id @default(uuid())
  groupId    String
  userId     String
  isAdmin    Boolean   @default(false)
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id        String   @id @default(uuid())
  groupId   String
  sender    String
  text      String   @default("")
  mediaUrl  String   @default("")
  mediaType String   @default("none")
  mentions  String[] @default([])
  createdAt DateTime @default(now())

  group      ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderUser User      @relation("GroupMessageSender", fields: [sender], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt])
  @@index([sender])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @default(now())
}

model DeletedLog {
  id            String    @id @default(uuid())
  originalId    String    @default("")
  itemType      String    @default("Cash Transaction")
  category      String    @default("")
  txType        String    @default("expense")
  amount        Float     @default(0)
  paymentMode   String    @default("handcash")
  date          DateTime?
  description   String    @default("")
  taggedPerson  String    @default("")
  loggedByStaff String    @default("")
  deletedBy     String
  deletedByName String    @default("")
  deletedAt     DateTime  @default(now())

  deleter User @relation("DeletedLogUser", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([deletedAt])
  @@index([deletedBy])
}

/**
 * ------------------------------------------------------------------
 * Toy production.
 * A toy belongs to a type, and passes through a few processes — body
 * assembly, a joint, gumming, checking. The supervisor records how long a
 * worker spent on one process and how many pieces came out, so the office
 * can see output per hour instead of a bare total.
 * ------------------------------------------------------------------
 */

model ToyType {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  toys Toy[]

  @@index([sortOrder])
}

model Toy {
  id        String   @id @default(uuid())
  typeId    String
  name      String
  code      String   @default("")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  type      ToyType           @relation(fields: [typeId], references: [id], onDelete: Restrict)
  processes ToyProcess[]
  entries   ProductionEntry[]

  @@index([typeId])
  @@index([name])
}

model ToyProcess {
  id            String   @id @default(uuid())
  toyId         String
  name          String
  sortOrder     Int      @default(0)
  /**
   * Expected pieces an hour. 0 means "no target set".
   */
  targetPerHour Int      @default(0)
  /**
   * What a whole shift should produce. The floor runs eight-hour and
   * twelve-hour shifts, and a long shift is not simply the rate times twelve —
   * so each is stored on its own. 0 falls back to the hourly rate.
   */
  target8h      Int      @default(0)
  target12h     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  toy     Toy               @relation(fields: [toyId], references: [id], onDelete: Cascade)
  entries ProductionEntry[]

  @@index([toyId])
}

/**
 * One worker's day: when they came, when they left, and so how long they had.
 */
model ProductionDay {
  id               String   @id @default(uuid())
  date             DateTime
  labourId         String
  /**
   * present | half | leave
   */
  status           String   @default("present")
  inTime           String   @default("")
  outTime          String   @default("")
  breakMinutes     Int?
  /**
   * Minutes actually available after a late start or an early finish.
   */
  availableMinutes Int      @default(0)
  note             String   @default("")
  enteredBy        String   @default("")
  enteredByName    String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@unique([date, labourId])
  @@index([date])
  @@index([labourId])
}

model ProductionEntry {
  id            String   @id @default(uuid())
  date          DateTime
  labourId      String
  toyId         String
  processId     String
  /**
   * Time spent on this process.
   */
  minutes       Int      @default(0)
  pieces        Int      @default(0)
  note          String   @default("")
  /**
   * regular, training or cover — how this piece of work should be read.
   */
  workType      String   @default("regular")
  enteredBy     String   @default("")
  enteredByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  toy     Toy        @relation(fields: [toyId], references: [id], onDelete: Restrict)
  process ToyProcess @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([labourId])
  @@index([toyId])
  @@index([processId])
}

/**
 * Every change kept, so a corrected number can always be traced back.
 */
model DamagePart {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model DamageEntry {
  id            String   @id @default(uuid())
  date          DateTime
  /**
   * Typed by hand, and kept so it can be picked again next time.
   */
  toyName       String
  partId        String   @default("")
  partName      String
  qty           Int      @default(0)
  enteredBy     String   @default("")
  enteredByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([date])
}

model ProductionLog {
  id      String   @id @default(uuid())
  entryId String   @default("")
  action  String
  summary String   @default("")
  before  Json?
  after   Json?
  byName  String   @default("")
  at      DateTime @default(now())

  @@index([at])
  @@index([entryId])
}
